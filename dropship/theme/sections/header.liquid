<header class="header">
  <div class="container header__row">
    <button type="button" class="header__icon header__menu-btn" aria-controls="MenuDrawer" aria-expanded="false" data-menu-open aria-label="תפריט">
      {% render 'icon', name: 'menu' %}
    </button>
    <a href="{{ routes.root_url }}" class="header__logo" aria-label="{{ settings.brand_name | default: shop.name }}, לדף הבית">
      {%- if settings.logo != blank -%}
        {{ settings.logo | image_url: width: 480 | image_tag: width: settings.logo_width, height: null, alt: settings.brand_name, style: 'height:auto' }}
      {%- else -%}
        <span class="wordmark">{{ settings.brand_name | default: shop.name }}</span>
      {%- endif -%}
    </a>
    <nav class="header__nav" aria-label="ראשי">
      {%- for link in section.settings.menu.links -%}
        <a href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a>
      {%- endfor -%}
    </nav>
    <div class="header__end">
      <a href="{{ routes.cart_url }}" class="header__icon" aria-label="סל הקניות, {{ cart.item_count }} פריטים">
        {% render 'icon', name: 'bag' %}
        {%- if cart.item_count > 0 -%}<span class="header__count">{{ cart.item_count }}</span>{%- endif -%}
      </a>
    </div>
  </div>
  <div class="drawer" id="MenuDrawer" hidden data-menu>
    <div class="drawer__panel" role="dialog" aria-modal="true" aria-label="תפריט">
      <button type="button" class="header__icon" data-menu-close aria-label="סגירת התפריט">{% render 'icon', name: 'x' %}</button>
      <nav aria-label="תפריט נייד">
        {%- for link in section.settings.menu.links -%}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {%- endfor -%}
      </nav>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "כותרת עליונה",
  "tag": "div",
  "class": "section-header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "תפריט",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
