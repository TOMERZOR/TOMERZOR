{%- comment -%}
  Self-hosted fonts (SIL OFL) and the colour settings from the theme editor.
  Heebo covers Hebrew characters, so the store reads well in Hebrew too.
{%- endcomment -%}
{%- liquid
  assign latin = 'U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD'
  assign latin_ext = 'U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF'
-%}
<style>
  @font-face { font-family: "Inter Tight"; font-style: normal; font-weight: 400 800; font-display: swap; src: url("{{ 'inter-tight-latin.woff2' | asset_url }}") format("woff2"); unicode-range: {{ latin }}; }
  @font-face { font-family: "Inter Tight"; font-style: normal; font-weight: 400 800; font-display: swap; src: url("{{ 'inter-tight-latin-ext.woff2' | asset_url }}") format("woff2"); unicode-range: {{ latin_ext }}; }
  @font-face { font-family: "Heebo"; font-style: normal; font-weight: 400 800; font-display: swap; src: url("{{ 'heebo-hebrew.woff2' | asset_url }}") format("woff2"); unicode-range: U+0307-0308, U+0590-05FF, U+200C-2010, U+20AA, U+25CC, U+FB1D-FB4F; }
  @font-face { font-family: "Pinyon Script"; font-style: normal; font-weight: 400; font-display: swap; src: url("{{ 'pinyon-script-latin.woff2' | asset_url }}") format("woff2"); unicode-range: {{ latin }}; }
  @font-face { font-family: "Pinyon Script"; font-style: normal; font-weight: 400; font-display: swap; src: url("{{ 'pinyon-script-latin-ext.woff2' | asset_url }}") format("woff2"); unicode-range: {{ latin_ext }}; }

  :root {
    --ink: {{ settings.color_ink }};
    --ink-soft: {{ settings.color_ink_soft }};
    --paper: {{ settings.color_paper }};
    --tile: {{ settings.color_tile }};
    --bar: {{ settings.color_bar }};
    --mustard: {{ settings.color_accent }};
    --red: {{ settings.color_accent_2 }};
  }
</style>
