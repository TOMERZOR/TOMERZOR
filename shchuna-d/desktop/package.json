{
  "name": "shchuna-d-desktop",
  "private": true,
  "version": "1.0.0",
  "description": "שכונה ד׳ for Windows: the game in an Electron shell.",
  "main": "main.js",
  "scripts": {
    "sync": "node sync.mjs",
    "start": "node sync.mjs && electron .",
    "win": "node sync.mjs && electron-builder --win portable --x64"
  },
  "devDependencies": { "electron": "33.2.0", "electron-builder": "25.1.8" },
  "build": {
    "appId": "com.tomerzor.shchunad",
    "productName": "Shchuna D",
    "files": ["main.js", "www/**/*"],
    "asar": false,
    "directories": { "output": "out" },
    "win": { "target": "portable", "signAndEditExecutable": false },
    "portable": { "artifactName": "ShchunaD.exe" }
  }
}
