{%- if section.blocks.size > 0 -%}
<section class="section{% if section.settings.bg == 'alt' %} section--alt{% endif %}">
  <div class="container">
    {%- if section.settings.title != blank -%}<h2 class="section__title">{{ section.settings.title }}</h2>{%- endif -%}
    {%- for block in section.blocks -%}{% render block %}{%- endfor -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "אפליקציות (ביקורות)",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "כותרת",
      "default": "מה הלקוחות אומרות"
    },
    {
      "type": "select",
      "id": "bg",
      "label": "רקע",
      "options": [
        {
          "value": "",
          "label": "רגיל"
        },
        {
          "value": "alt",
          "label": "משני"
        }
      ],
      "default": ""
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "אפליקציות (ביקורות)"
    }
  ]
}
{% endschema %}
