<!doctype html>
<html lang="he" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ shop.name }}</title>
  {% render 'meta-tags' %}
  <style>
    @font-face { font-family: 'Heebo'; src: url('{{ 'heebo-hebrew.woff2' | asset_url }}') format('woff2'); font-weight: 100 900; font-display: swap; }
    :root { --bg: {{ settings.color_bg }}; --bg-alt: {{ settings.color_bg_alt }}; --ink: {{ settings.color_ink }}; --muted: {{ settings.color_muted }}; --accent: {{ settings.color_accent }}; --accent-ink: {{ settings.color_accent_ink }}; --line: {{ settings.color_line }}; --sale: {{ settings.color_sale }}; }
  </style>
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body class="template-password">
  <main id="MainContent">{{ content_for_layout }}</main>
</body>
</html>
