{%- if section.blocks.size > 0 -%}
  <div class="bar" role="region" aria-label="{{ 'general.announcements' | t }}" {{ section.shopify_attributes }}>
    <div class="bar__track">
      {%- for i in (1..4) -%}
        {%- for block in section.blocks -%}
          <span {% if i == 1 %}{{ block.shopify_attributes }}{% else %}aria-hidden="true"{% endif %}>
            {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a>{%- else -%}{{ block.settings.text | escape }}{%- endif -%}
          </span>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "class": "section-bar",
  "enabled_on": { "groups": ["header"] },
  "max_blocks": 8,
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free shipping on orders over 400 NIS" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [
        { "type": "message", "settings": { "text": "Free shipping on orders over 400 NIS" } },
        { "type": "message", "settings": { "text": "30 days easy returns & exchanges" } },
        { "type": "message", "settings": { "text": "Taxes included" } }
      ]
    }
  ]
}
{% endschema %}
