<section class="section">
  <div class="container">
    <h1 class="section__title">חיפוש</h1>
    <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
      <label class="visually-hidden" for="q">חיפוש</label>
      <input id="q" type="search" name="q" value="{{ search.terms | escape }}" placeholder="מה מחפשים?">
      <input type="hidden" name="type" value="product">
      <button type="submit" class="btn">חיפוש</button>
    </form>
    {%- if search.performed -%}
      <div class="grid">
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}{% render 'product-card', product: item %}{%- endif -%}
        {%- else -%}
          <p class="empty-state">לא נמצאו תוצאות עבור &laquo;{{ search.terms | escape }}&raquo;.</p>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "תוצאות חיפוש",
  "tag": "div"
}
{% endschema %}
