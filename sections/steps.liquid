<section class="section{% if section.settings.bg == 'tint' %} section--tint{% endif %}" id="how">
  <div class="container">
    <div class="section-head reveal">
      <h2 class="display h2">{{ section.settings.title }}</h2>
    </div>
    <ol class="steps">
      {%- for block in section.blocks -%}
        <li class="step reveal" style="--i: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
          <div class="step__img">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 30vw, 78vw', widths: '400, 600, 800', alt: block.settings.title }}
            {%- elsif block.settings.fallback != blank -%}
              {{ block.settings.fallback | asset_url | image_tag: loading: 'lazy', alt: block.settings.title, width: 676, height: 912 }}
            {%- endif -%}
          </div>
          <div class="step__label">
            <span class="step__num" aria-hidden="true">{{ forloop.index }}</span>
            <h3 class="step__title">{{ block.settings.title }}</h3>
          </div>
          <p class="step__text">{{ block.settings.text }}</p>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "איך זה עובד",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "כותרת",
      "default": "3 צעדים, 5 דקות"
    },
    {
      "type": "select",
      "id": "bg",
      "label": "רקע",
      "options": [
        {
          "value": "",
          "label": "רגיל"
        },
        {
          "value": "tint",
          "label": "משני"
        }
      ],
      "default": ""
    }
  ],
  "max_blocks": 4,
  "blocks": [
    {
      "type": "step",
      "name": "צעד",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "תמונה"
        },
        {
          "type": "text",
          "id": "fallback",
          "label": "תמונת ברירת מחדל מהערכה"
        },
        {
          "type": "text",
          "id": "title",
          "label": "פועל (מילה אחת)",
          "default": "מניחות"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "טקסט"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "איך זה עובד"
    }
  ]
}
{% endschema %}
