<section class="section password">
  <div class="container container--narrow center">
    <p class="wordmark">{{ shop.name }}</p>
    <h1 class="section__title">{{ section.settings.title }}</h1>
    {%- if shop.password_message != blank -%}<p>{{ shop.password_message }}</p>{%- endif -%}
    {%- form 'customer', class: 'newsletter' -%}
      <input type="hidden" name="contact[tags]" value="prospect,password page">
      {%- if form.posted_successfully? -%}<p class="notice" role="status">נרשמת! נעדכן אותך כשנפתח.</p>{%- endif -%}
      <label class="visually-hidden" for="pw-email">אימייל</label>
      <input id="pw-email" type="email" name="contact[email]" placeholder="האימייל שלך" required>
      <label class="consent"><input type="checkbox" name="contact[accepts_marketing]" value="true" required> אני מאשרת לקבל דיוור ופרסומות במייל (אפשר להסיר בכל רגע)</label>
      <button type="submit" class="btn">עדכנו אותי</button>
    {%- endform -%}
    <details class="password__login">
      <summary>כניסה עם סיסמה</summary>
      {%- form 'storefront_password' -%}
        {%- if form.errors -%}<p class="notice notice--error">סיסמה שגויה</p>{%- endif -%}
        <label class="visually-hidden" for="pw">סיסמה</label>
        <input id="pw" type="password" name="password" autocomplete="current-password" placeholder="סיסמה">
        <button type="submit" class="btn btn--ghost">כניסה</button>
      {%- endform -%}
    </details>
  </div>
</section>

{% schema %}
{
  "name": "עמוד סיסמה",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "כותרת",
      "default": "נפתחים בקרוב"
    }
  ]
}
{% endschema %}
