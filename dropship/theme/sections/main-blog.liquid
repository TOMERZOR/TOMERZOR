<section class="section">
  <div class="container container--narrow">
    <h1 class="section__title">{{ blog.title }}</h1>
    {%- paginate blog.articles by 12 -%}
      <div class="articles">
        {%- for article in blog.articles -%}
          <article class="article-card">
            {%- if article.image -%}<a href="{{ article.url }}">{{ article.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: article.title }}</a>{%- endif -%}
            <h2><a href="{{ article.url }}">{{ article.title }}</a></h2>
            <p>{{ article.excerpt_or_content | strip_html | truncatewords: 30 }}</p>
          </article>
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}<nav class="pagination" aria-label="עמודים">{{ paginate | default_pagination }}</nav>{%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "בלוג",
  "tag": "div"
}
{% endschema %}
