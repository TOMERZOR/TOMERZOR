<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <span class="wordmark">{{ shop.name }}</span>
      {%- if section.settings.about != blank -%}<div class="rte">{{ section.settings.about }}</div>{%- endif -%}
      <div class="footer__social">
        {%- if settings.social_facebook != blank -%}<a href="{{ settings.social_facebook }}" aria-label="פייסבוק">{% render 'icon', name: 'facebook' %}</a>{%- endif -%}
        {%- if settings.social_instagram != blank -%}<a href="{{ settings.social_instagram }}" aria-label="אינסטגרם">{% render 'icon', name: 'instagram' %}</a>{%- endif -%}
        {%- if settings.social_tiktok != blank -%}<a href="{{ settings.social_tiktok }}" aria-label="טיקטוק">{% render 'icon', name: 'tiktok' %}</a>{%- endif -%}
      </div>
    </div>
    <nav class="footer__links" aria-label="מידע ומדיניות">
      <p class="footer__head">מידע</p>
      {%- for link in section.settings.menu.links -%}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {%- endfor -%}
      {%- for policy in shop.policies -%}
        <a href="{{ policy.url }}">{{ policy.title }}</a>
      {%- endfor -%}
    </nav>
    <div class="footer__biz">
      <p class="footer__head">פרטי העסק</p>
      <div class="rte">{{ section.settings.business }}</div>
      {%- if shop.email != blank -%}<p><a href="mailto:{{ shop.email }}">{{ shop.email }}</a></p>{%- endif -%}
    </div>
  </div>
  <div class="container footer__bottom">
    <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. כל הזכויות שמורות.</p>
  </div>
</footer>
{%- if settings.whatsapp_number != blank -%}
  <a class="wa-float" href="https://wa.me/{{ settings.whatsapp_number | remove: '+' | remove: ' ' | remove: '-' }}" target="_blank" rel="noopener" aria-label="שירות לקוחות בוואטסאפ">{% render 'icon', name: 'whatsapp' %}</a>
{%- endif -%}

{% schema %}
{
  "name": "כותרת תחתונה",
  "tag": "div",
  "settings": [
    {
      "type": "richtext",
      "id": "about",
      "label": "על המותג",
      "default": "<p>אביזרי שיער מסאטן לתלתלים בלי חום. נבחרו ונבדקו בשבילך.</p>"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "תפריט קישורים",
      "default": "footer"
    },
    {
      "type": "richtext",
      "id": "business",
      "label": "פרטי העסק (חובה לפי חוק הגנת הצרכן)",
      "default": "<p>[שם העסק] · עוסק [פטור/מורשה] מס' [מספר]<br>[כתובת מלאה]<br>טלפון: [מספר טלפון]</p>"
    }
  ]
}
{% endschema %}
