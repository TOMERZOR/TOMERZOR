<section class="section">
  <div class="container">
    <h1 class="page-title">{{ collection.title }}</h1>
    {%- if collection.description != blank -%}<div class="rte center">{{ collection.description }}</div>{%- endif -%}
    {%- paginate collection.products by 24 -%}
      <div class="grid">
        {%- for p in collection.products -%}
          {% render 'product-card', product: p %}
        {%- else -%}
          <p class="empty-state">אין מוצרים באוסף הזה עדיין.</p>
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}<nav class="pagination" aria-label="עמודים">{{ paginate | default_pagination }}</nav>{%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "אוסף מוצרים",
  "tag": "div"
}
{% endschema %}
