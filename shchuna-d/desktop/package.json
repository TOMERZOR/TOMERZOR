{
  "name": "shchuna-d-desktop",
  "private": true,
  "version": "1.1.0",
  "description": "שכונה ד׳ for Windows: a window onto the live game, which updates itself.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "win": "electron-builder --win dir --x64"
  },
  "devDependencies": {
    "electron": "33.2.0",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.tomerzor.shchunad",
    "productName": "Shchuna D",
    "files": [
      "main.js",
      "offline.html"
    ],
    "directories": {
      "output": "out"
    },
    "win": {
      "target": "dir",
      "signAndEditExecutable": false
    },
    "compression": "maximum",
    "electronLanguages": [
      "en-US",
      "he"
    ]
  }
}
