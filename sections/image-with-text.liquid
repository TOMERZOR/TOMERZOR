<section class="section{% if section.settings.bg == 'tint' %} section--tint{% endif %}">
  <div class="container feature{% if section.settings.flip %} feature--flip{% endif %}">
    <div class="feature__media reveal">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 50vw, 100vw', widths: '400, 600, 800, 1000, 1200', alt: section.settings.image.alt }}
      {%- elsif section.settings.fallback != blank -%}
        {{ section.settings.fallback | asset_url | image_tag: loading: 'lazy', alt: section.settings.alt, width: 1000, height: 1000 }}
      {%- endif -%}
    </div>
    <div class="feature__copy reveal" style="--i: 1">
      <h2 class="display h2">{{ section.settings.title }}</h2>
      <div class="lead rte">{{ section.settings.text }}</div>
      {%- if section.settings.button_text != blank -%}
        <a class="btn" href="#buy"{% if section.settings.pick != blank %} data-pick="{{ section.settings.pick | escape }}"{% endif %}>{{ section.settings.button_text }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "תמונה עם טקסט",
  "tag": "div",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "תמונה"
    },
    {
      "type": "text",
      "id": "fallback",
      "label": "תמונת ברירת מחדל מהערכה",
      "default": "gift.jpg"
    },
    {
      "type": "text",
      "id": "alt",
      "label": "תיאור התמונה (נגישות)",
      "default": "שני סטי סאטן בקופסת מתנה"
    },
    {
      "type": "checkbox",
      "id": "flip",
      "label": "תמונה בצד השני",
      "default": false
    },
    {
      "type": "text",
      "id": "title",
      "label": "כותרת",
      "default": "2 סטים, אחד מהם למתנה"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "טקסט",
      "default": "<p>כל סט מגיע בשקית סאטן משלו. בחבילה של 2 כל סט יוצא 90 ₪ במקום 119 ₪.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "טקסט כפתור",
      "default": "לחבילת 2 סטים"
    },
    {
      "type": "text",
      "id": "pick",
      "label": "חבילה שתיבחר אוטומטית בלחיצה",
      "default": "2 סטים"
    },
    {
      "type": "select",
      "id": "bg",
      "label": "רקע",
      "options": [
        {
          "value": "",
          "label": "רגיל"
        },
        {
          "value": "tint",
          "label": "משני"
        }
      ],
      "default": ""
    }
  ],
  "presets": [
    {
      "name": "תמונה עם טקסט"
    }
  ]
}
{% endschema %}
