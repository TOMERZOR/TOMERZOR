<section class="section{% if section.settings.bg == 'tint' %} section--tint{% endif %}">
  <div class="container container--narrow closer reveal">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 240, height: 240, crop: 'center' | image_tag: class: 'closer__img', loading: 'lazy', alt: '' }}
    {%- elsif section.settings.fallback != blank -%}
      {{ section.settings.fallback | asset_url | image_tag: class: 'closer__img', loading: 'lazy', alt: '', width: 120, height: 120 }}
    {%- endif -%}
    <h2 class="display h2">{{ section.settings.title }}</h2>
    {%- if section.settings.text != blank -%}<p class="lead">{{ section.settings.text }}</p>{%- endif -%}
    {%- if section.settings.button_text != blank -%}
      <a class="btn" href="#buy">{{ section.settings.button_text }} {% render 'icon', name: 'arrow' %}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "קריאה לפעולה",
  "tag": "div",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "תמונה קטנה עגולה"
    },
    {
      "type": "text",
      "id": "fallback",
      "label": "תמונת ברירת מחדל מהערכה",
      "default": "product-hero.jpg"
    },
    {
      "type": "text",
      "id": "title",
      "label": "כותרת",
      "default": "מוכנה להתעורר עם תלתלים?"
    },
    {
      "type": "text",
      "id": "text",
      "label": "טקסט",
      "default": "משלוח חינם וביטול עסקה תוך 14 יום."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "טקסט כפתור",
      "default": "להזמנה"
    },
    {
      "type": "select",
      "id": "bg",
      "label": "רקע",
      "options": [
        {
          "value": "",
          "label": "רגיל"
        },
        {
          "value": "tint",
          "label": "משני"
        }
      ],
      "default": ""
    }
  ],
  "presets": [
    {
      "name": "קריאה לפעולה"
    }
  ]
}
{% endschema %}
