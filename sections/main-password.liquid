<div class="password">
  <div class="logo password__logo">{{ shop.name | escape }}</div>
  <h1 class="campaign__title">{{ section.settings.title | escape }} <span class="script">{{ section.settings.script | escape }}</span></h1>
  {%- if shop.password_message != blank -%}<p class="password__msg">{{ shop.password_message | escape }}</p>{%- endif -%}
  {%- form 'customer', class: 'password__signup' -%}
    <input type="hidden" name="contact[tags]" value="newsletter, prelaunch">
    {%- if form.posted_successfully? -%}
      <p class="form-status" role="status">{{ 'newsletter.success' | t }}</p>
    {%- else -%}
      <label class="sr-only" for="pw-email">{{ 'newsletter.email' | t }}</label>
      <input class="news__field" id="pw-email" type="email" name="contact[email]" placeholder="{{ 'newsletter.email' | t }}" required>
      <label class="consent" for="pw-consent"><input id="pw-consent" type="checkbox" required><span>{{ 'newsletter.consent' | t: shop: shop.name }}</span></label>
      <button class="pill pill--ink" type="submit">{{ 'newsletter.notify' | t }}</button>
    {%- endif -%}
  {%- endform -%}
  <details class="password__enter">
    <summary class="link-btn">{{ 'password.enter' | t }}</summary>
    {%- form 'storefront_password' -%}
      {%- if form.errors -%}<div class="form-status form-status--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
      <label class="sr-only" for="pw-input">{{ 'password.label' | t }}</label>
      <input class="news__field" id="pw-input" type="password" name="password" placeholder="{{ 'password.label' | t }}" autocomplete="current-password">
      <button class="pill pill--line" type="submit">{{ 'password.submit' | t }}</button>
    {%- endform -%}
  </details>
</div>
{% schema %}
{
  "name": "Password page",
  "class": "section-main-password",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Coming" },
    { "type": "text", "id": "script", "label": "Heading (script word)", "default": "soon" }
  ]
}
{% endschema %}
