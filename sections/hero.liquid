{%- liquid
  assign img = section.settings.image
-%}
<section class="hero{% if section.settings.layout == 'overlay' %} hero--overlay{% endif %}">
  <div class="hero__media">
    {%- if img != blank -%}
      {{ img | image_url: width: 1800 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '100vw', widths: '600, 900, 1200, 1500, 1800', alt: img.alt }}
    {%- else -%}
      {{ 'hero-night.jpg' | asset_url | image_tag: loading: 'eager', fetchpriority: 'high', alt: '' }}
    {%- endif -%}
  </div>
  <div class="hero__copy">
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="hero__title">{{ section.settings.title }}</h2>
    {%- if section.settings.text != blank -%}<div class="hero__text rte">{{ section.settings.text }}</div>{%- endif -%}
    {%- if section.settings.button_text != blank -%}
      <a class="btn" href="{{ section.settings.button_link | default: '#buy' }}">{{ section.settings.button_text }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "באנר ראשי",
  "tag": "div",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "תמונה"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "פריסה",
      "options": [
        {
          "value": "overlay",
          "label": "טקסט על התמונה"
        },
        {
          "value": "split",
          "label": "תמונה וטקסט זה לצד זה"
        }
      ],
      "default": "split"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "שורה קטנה",
      "default": "החדש של הלילה"
    },
    {
      "type": "text",
      "id": "title",
      "label": "כותרת",
      "default": "הולכת לישון. מתעוררת עם תלתלים."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "טקסט",
      "default": "<p>מוט סלסול מסאטן שעושה את העבודה בזמן שאת ישנה. בלי מסלסל, בלי פן, בלי נזק מחום.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "טקסט כפתור",
      "default": "אני רוצה תלתלים"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "קישור כפתור (ריק = גלילה לרכישה)"
    }
  ],
  "presets": [
    {
      "name": "באנר ראשי"
    }
  ]
}
{% endschema %}
