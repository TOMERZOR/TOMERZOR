<article class="page-wrap policy">
  <p class="policy__meta">{{ article.published_at | time_tag: format: 'date' }}</p>
  <h1 class="policy__title">{{ article.title | escape }}</h1>
  {%- if article.image -%}
    <div class="article__image">{{ article.image | image_url: width: 1400 | image_tag: widths: '700, 1000, 1400', sizes: '(min-width: 760px) 720px, 100vw', alt: article.image.alt | default: article.title }}</div>
  {%- endif -%}
  <div class="rte">{{ article.content }}</div>
  <p><a class="arrow-link" href="{{ blog.url }}">{% render 'icon', name: 'back' %} {{ blog.title | escape }}</a></p>
</article>

{% schema %}
{ "name": "Article", "class": "section-main-article", "settings": [] }
{% endschema %}
