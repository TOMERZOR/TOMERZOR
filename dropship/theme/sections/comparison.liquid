<section class="section{% if section.settings.bg == 'alt' %} section--alt{% endif %}">
  <div class="container container--narrow">
    <h2 class="section__title">{{ section.settings.title }}</h2>
    <table class="compare">
      <thead><tr><th scope="col"></th><th scope="col" class="compare__us">{{ section.settings.us }}</th><th scope="col">{{ section.settings.them }}</th></tr></thead>
      <tbody>
        {%- for block in section.blocks -%}
          <tr {{ block.shopify_attributes }}>
            <th scope="row">{{ block.settings.label }}</th>
            <td class="compare__us">{% if block.settings.us %}{% render 'icon', name: 'check' %}<span class="visually-hidden">כן</span>{% else %}{% render 'icon', name: 'x' %}<span class="visually-hidden">לא</span>{% endif %}</td>
            <td>{% if block.settings.them %}{% render 'icon', name: 'check' %}<span class="visually-hidden">כן</span>{% else %}{% render 'icon', name: 'x' %}<span class="visually-hidden">לא</span>{% endif %}</td>
          </tr>
        {%- endfor -%}
      </tbody>
    </table>
  </div>
</section>

{% schema %}
{
  "name": "השוואה",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "כותרת",
      "default": "מוט סאטן מול מסלסל חשמלי"
    },
    {
      "type": "text",
      "id": "us",
      "label": "עמודה שלנו",
      "default": "מוט סאטן"
    },
    {
      "type": "text",
      "id": "them",
      "label": "עמודה שנייה",
      "default": "מסלסל / פן"
    },
    {
      "type": "select",
      "id": "bg",
      "label": "רקע",
      "options": [
        {
          "value": "",
          "label": "רגיל"
        },
        {
          "value": "alt",
          "label": "משני"
        }
      ],
      "default": "alt"
    }
  ],
  "max_blocks": 8,
  "blocks": [
    {
      "type": "row",
      "name": "שורה",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "תכונה",
          "default": "תכונה"
        },
        {
          "type": "checkbox",
          "id": "us",
          "label": "אצלנו",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "them",
          "label": "אצלם",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "השוואה",
      "blocks": [
        {
          "type": "row",
          "settings": {
            "label": "בלי חום על השיער",
            "us": true,
            "them": false
          }
        },
        {
          "type": "row",
          "settings": {
            "label": "עובד בזמן שאת ישנה",
            "us": true,
            "them": false
          }
        },
        {
          "type": "row",
          "settings": {
            "label": "לא צריך חשמל",
            "us": true,
            "them": false
          }
        },
        {
          "type": "row",
          "settings": {
            "label": "קל לקחת לנסיעות",
            "us": true,
            "them": false
          }
        },
        {
          "type": "row",
          "settings": {
            "label": "תוצאה תוך פחות מחצי שעה",
            "us": false,
            "them": true
          }
        }
      ]
    }
  ]
}
{% endschema %}
