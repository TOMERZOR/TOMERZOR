{%- liquid
  assign business_name = settings.legal_name | default: shop.name
  assign current_year = 'now' | date: '%Y'
-%}
<footer class="footer" id="footer">
  <div class="footer__top">
    {%- if section.settings.show_newsletter -%}
      <div class="news">
        <h2 class="news__title">{{ section.settings.newsletter_title | escape }} <span class="script">{{ section.settings.newsletter_script | escape }}</span></h2>
        <p>{{ section.settings.newsletter_text | escape }}</p>
        {%- form 'customer', id: 'NewsletterForm', class: 'news__form', data-newsletter: '' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          {%- if form.posted_successfully? -%}
            <p class="news__msg" role="status" tabindex="-1" autofocus>{{ 'newsletter.success' | t }}</p>
          {%- else -%}
            <label class="sr-only" for="news-email">{{ 'newsletter.email' | t }}</label>
            <input class="news__field" id="news-email" type="email" name="contact[email]" placeholder="{{ 'newsletter.email' | t }}" autocomplete="email" required value="{{ form.email }}">
            <label class="sr-only" for="news-year">{{ 'newsletter.year' | t }}</label>
            <select class="news__field" id="news-year" required>
              <option value="">{{ 'newsletter.year' | t }}</option>
              {%- assign this_year = 'now' | date: '%Y' | plus: 0 -%}
              {%- for i in (0..89) -%}
                <option>{{ this_year | minus: i }}</option>
              {%- endfor -%}
            </select>
            <label class="consent" for="news-consent">
              <input id="news-consent" type="checkbox" required>
              <span>
                {{ 'newsletter.consent' | t: shop: shop.name }}
                {%- if shop.privacy_policy != blank %} <a href="{{ shop.privacy_policy.url }}">{{ shop.privacy_policy.title | escape }}</a>{% endif -%}
              </span>
            </label>
            <button class="pill pill--ink" type="submit">{{ 'newsletter.subscribe' | t }}</button>
            <div class="news__msg" id="news-msg" role="status">
              {%- if form.errors -%}{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}{%- endif -%}
            </div>
          {%- endif -%}
        {%- endform -%}
      </div>
    {%- endif -%}

    {%- for block in section.blocks -%}
      <div class="fcol" {{ block.shopify_attributes }}>
        <h2>{{ block.settings.heading | escape }}</h2>
        {%- if block.settings.menu != blank -%}
          <ul>
            {%- for link in block.settings.menu.links -%}
              <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>

  {%- if section.settings.show_wordmark -%}
    <div class="footer__mark" aria-hidden="true">{{ section.settings.wordmark_first | escape }}<sup>®</sup>{{ section.settings.wordmark_second | escape }}</div>
  {%- endif -%}

  <nav class="footer__policies" aria-label="{{ 'footer.legal' | t }}">
    {%- for policy in shop.policies -%}
      <a href="{{ policy.url }}">{{ policy.title | escape }}</a>
    {%- endfor -%}
    {%- if settings.cookie_policy_page != blank -%}<a href="{{ settings.cookie_policy_page.url }}">{{ settings.cookie_policy_page.title | escape }}</a>{%- endif -%}
    {%- if settings.accessibility_page != blank -%}<a href="{{ settings.accessibility_page.url }}">{{ settings.accessibility_page.title | escape }}</a>{%- endif -%}
    <button type="button" data-cookie-settings>{{ 'footer.cookie_settings' | t }}</button>
  </nav>

  <div class="footer__legal">
    <span>© {{ current_year }} {{ business_name | escape }}{% if settings.business_id != blank %} · {{ settings.business_id | escape }}{% endif %}</span>
    {%- if shop.address.summary != blank or shop.email != blank -%}
      <span>{{ shop.address.summary | escape }}{% if shop.address.summary != blank and shop.email != blank %} · {% endif %}{{ shop.email | escape }}</span>
    {%- endif -%}
    <span>{%- if cart.taxes_included -%}{{ 'cart.taxes_included' | t }}{%- else -%}{{ 'cart.taxes_at_checkout' | t }}{%- endif -%}</span>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "enabled_on": { "groups": ["footer"] },
  "max_blocks": 4,
  "settings": [
    { "type": "checkbox", "id": "show_newsletter", "label": "Show newsletter signup", "default": true },
    { "type": "text", "id": "newsletter_title", "label": "Newsletter heading", "default": "Join the" },
    { "type": "text", "id": "newsletter_script", "label": "Newsletter heading (script word)", "default": "Dream" },
    { "type": "text", "id": "newsletter_text", "label": "Newsletter text", "default": "New drops first. No spam." },
    { "type": "checkbox", "id": "show_wordmark", "label": "Show large wordmark", "default": true },
    { "type": "text", "id": "wordmark_first", "label": "Wordmark first word", "default": "Dream" },
    { "type": "text", "id": "wordmark_second", "label": "Wordmark second word", "default": "Studios" }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    }
  ]
}
{% endschema %}
