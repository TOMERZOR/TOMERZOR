{%- layout none -%}
<!doctype html>
<html lang="he" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>כרטיס מתנה | {{ settings.brand_name | default: shop.name }}</title>
  <style>
    @font-face { font-family: 'Heebo'; src: url('{{ 'heebo-hebrew.woff2' | asset_url }}') format('woff2'); font-weight: 100 900; font-display: swap; }
    :root { --bg: {{ settings.color_bg }}; --bg-alt: {{ settings.color_bg_alt }}; --ink: {{ settings.color_ink }}; --muted: {{ settings.color_muted }}; --accent: {{ settings.color_accent }}; --accent-ink: {{ settings.color_accent_ink }}; --line: {{ settings.color_line }}; --sale: {{ settings.color_sale }}; }
  </style>
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
  {{ content_for_header }}
</head>
<body>
  <main class="section">
    <div class="container container--narrow center">
      <p class="wordmark">{{ settings.brand_name | default: shop.name }}</p>
      <h1 class="page-title">כרטיס מתנה בשווי {% render 'money', cents: gift_card.balance %}</h1>
      {%- if gift_card.expired or gift_card.enabled == false -%}<p class="notice notice--error">הכרטיס אינו פעיל.</p>{%- endif -%}
      <p>הקוד לשימוש בקופה:</p>
      <p class="gift-code"><strong>{{ gift_card.code | format_code }}</strong></p>
      <div id="QrCode" data-identifier="{{ gift_card.qr_identifier }}"></div>
      <script>
        window.addEventListener('load', function () {
          var el = document.getElementById('QrCode');
          if (window.QRCode && el) new QRCode(el, { text: el.dataset.identifier, width: 120, height: 120 });
        });
      </script>
      <a class="btn" href="{{ shop.url }}">לחנות</a>
    </div>
  </main>
</body>
</html>
