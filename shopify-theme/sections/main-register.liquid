<div class="page-wrap account-form">
  <h1 class="policy__title">{{ 'customer.register_title' | t }}</h1>
  {%- form 'create_customer', novalidate: 'novalidate' -%}
    {%- if form.errors -%}<div class="form-status form-status--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
    <label class="field"><span>{{ 'customer.first_name' | t }}</span><input class="news__field" type="text" name="customer[first_name]" autocomplete="given-name"></label>
    <label class="field"><span>{{ 'customer.last_name' | t }}</span><input class="news__field" type="text" name="customer[last_name]" autocomplete="family-name"></label>
    <label class="field"><span>{{ 'customer.email' | t }}</span><input class="news__field" type="email" name="customer[email]" autocomplete="email" required></label>
    <label class="field"><span>{{ 'customer.password' | t }}</span><input class="news__field" type="password" name="customer[password]" autocomplete="new-password" required></label>
    <p class="fine">{{ 'customer.register_privacy' | t }}{% if shop.privacy_policy != blank %} <a href="{{ shop.privacy_policy.url }}">{{ shop.privacy_policy.title | escape }}</a>{% endif %}</p>
    <button class="pill pill--ink" type="submit">{{ 'customer.create' | t }}</button>
  {%- endform -%}
</div>
{% schema %}
{ "name": "Register", "class": "section-main-register", "settings": [] }
{% endschema %}
