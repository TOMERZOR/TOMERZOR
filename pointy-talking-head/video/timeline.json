{
 "dur": 47.1,
 "segments": [
  {
   "id": "A1",
   "take": "IMG_4294_f6b1",
   "t0": 1.22,
   "t1": 4.78,
   "chunk": 1,
   "text": "14 דקות של מדריך ביוטיוב בשביל כפתור אחד",
   "film0": 0.0,
   "film1": 3.56,
   "chunk0": 0.0
  },
  {
   "id": "A2",
   "take": "IMG_4294_f6b1",
   "t0": 8.8,
   "t1": 13.92,
   "chunk": 1,
   "text": "צפיתם, חזרתם, עצרתם… ובסוף זה בכלל לא נראה טוב",
   "film0": 3.56,
   "film1": 8.68,
   "chunk0": 3.56
  },
  {
   "id": "B",
   "take": "IMG_4295_5af9",
   "t0": 1.8,
   "t1": 5.1,
   "chunk": 1,
   "text": "והבעיה לא אצלכם, התוכנות פשוט לא אומרות לכם איפה הכפתור",
   "film0": 8.68,
   "film1": 11.98,
   "chunk0": 8.68
  },
  {
   "id": "C1",
   "take": "IMG_4296_11c2",
   "t0": 0.56,
   "t1": 3.12,
   "chunk": 1,
   "text": "אז תראו מה אני עושה היום, עם פוינטי",
   "film0": 11.98,
   "film1": 14.54,
   "chunk0": 11.98
  },
  {
   "id": "C2",
   "take": "IMG_4296_11c2",
   "t0": 6.18,
   "t1": 8.74,
   "chunk": 2,
   "text": "לוחץ במקלדת אופשן ורווח",
   "film0": 14.54,
   "film1": 17.1,
   "chunk0": 0.0
  },
  {
   "id": "C3",
   "take": "IMG_4296_11c2",
   "t0": 9.12,
   "t1": 10.52,
   "chunk": 2,
   "text": "ובמחשב זה אלט",
   "film0": 17.1,
   "film1": 18.5,
   "chunk0": 2.56
  },
  {
   "id": "D1",
   "take": "IMG_4298_2816",
   "t0": 2.26,
   "t1": 6.4,
   "chunk": 2,
   "text": "שואל אותו: איך אני עושה זום אין",
   "film0": 18.5,
   "film1": 22.64,
   "chunk0": 3.96
  },
  {
   "id": "D2",
   "take": "IMG_4298_2816",
   "t0": 8.92,
   "t1": 9.8,
   "chunk": 2,
   "text": "בפרימייר",
   "film0": 22.64,
   "film1": 23.52,
   "chunk0": 8.1
  },
  {
   "id": "D3",
   "take": "IMG_4298_2816",
   "t0": 13.08,
   "t1": 15.56,
   "chunk": 2,
   "text": "ועכשיו הוא אומר לי מה לעשות",
   "film0": 23.52,
   "film1": 26.0,
   "chunk0": 8.98
  },
  {
   "id": "E1",
   "take": "IMG_4298_da54",
   "t0": 0.62,
   "t1": 1.98,
   "chunk": 2,
   "text": "לוחץ עשיתי",
   "film0": 26.0,
   "film1": 27.36,
   "chunk0": 11.46
  },
  {
   "id": "E2",
   "take": "IMG_4298_da54",
   "t0": 5.2,
   "t1": 9.2,
   "chunk": 3,
   "text": "וזהו, חמש שניות במקום מדריך של 14 דקות",
   "film0": 27.36,
   "film1": 31.36,
   "chunk0": 0.0
  },
  {
   "id": "F",
   "take": "IMG_4299_d630",
   "t0": 0.82,
   "t1": 8.6,
   "chunk": 3,
   "text": "וזה לא עובד רק בפרימייר, זה עובד באקסל, באפטר אפקטס, כל תוכנה שיש לכם על המסך זה עובד בה, הוא יודע לעבוד איתה",
   "film0": 31.36,
   "film1": 39.14,
   "chunk0": 4.0
  },
  {
   "id": "G",
   "take": "IMG_4300_73c5",
   "t0": 1.74,
   "t1": 9.7,
   "chunk": 3,
   "text": "פוינטי עובד גם במקבוק וגם בווינדוס. תגיבו את המילה פלאגין בתגובות בשביל לקבל קישור בפרטי",
   "film0": 39.14,
   "film1": 47.1,
   "chunk0": 11.78
  }
 ],
