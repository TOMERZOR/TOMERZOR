<div class="page-wrap account-form">
  <h1 class="policy__title">{{ 'customer.activate_title' | t }}</h1>
  {%- form 'activate_customer_password' -%}
    {%- if form.errors -%}<div class="form-status form-status--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
    <label class="field"><span>{{ 'customer.password' | t }}</span><input class="news__field" type="password" name="customer[password]" autocomplete="new-password" required></label>
    <label class="field"><span>{{ 'customer.password_confirm' | t }}</span><input class="news__field" type="password" name="customer[password_confirmation]" autocomplete="new-password" required></label>
    <button class="pill pill--ink" type="submit" name="activate">{{ 'customer.activate' | t }}</button>
    <button class="pill pill--line" type="submit" name="decline">{{ 'customer.decline' | t }}</button>
  {%- endform -%}
</div>
{% schema %}
{ "name": "Activate account", "class": "section-main-activate", "settings": [] }
{% endschema %}
