{%- comment -%}
  Product card used in rails, collection grids, search and the wishlist.
  Shows the second product image on hover, a New / Sold Out tag and a wishlist heart.
  Tag a product "new" in Shopify to show the New label.
{%- endcomment -%}
{%- liquid
  assign first_image = product.featured_media.preview_image
  assign second_image = product.media[1].preview_image
  assign sizes = '(min-width: 1200px) 25vw, (min-width: 768px) 33vw, 50vw'
  assign tags = product.tags | join: ',' | downcase | split: ','
-%}
<article class="card">
  <a href="{{ product.url }}" class="card__link">
    <div class="card__media">
      {%- if first_image -%}
        {%- liquid
          assign main_class = 'solo'
          if second_image
            assign main_class = 'main'
          endif
        -%}
        {{ first_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900', sizes: sizes, alt: product.title, class: main_class }}
        {%- if second_image -%}
          {{ second_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900', sizes: sizes, alt: '', class: 'alt' }}
        {%- endif -%}
      {%- else -%}
        {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
      {%- if product.available == false -%}
        <span class="card__tag">{{ 'products.sold_out' | t }}</span>
      {%- elsif tags contains 'new' -%}
        <span class="card__tag">{{ 'products.new' | t }}</span>
      {%- endif -%}
    </div>
    <div class="card__info">
      <span class="card__name">{{ product.title | escape }}</span>
      <span class="card__price">{% render 'price', product: product %}</span>
      {% render 'swatches', product: product %}
    </div>
  </a>
  <button class="card__fav" type="button" data-fav="{{ product.handle }}" aria-pressed="false" aria-label="{{ 'wishlist.save' | t: title: product.title | escape }}">
    {%- render 'icon', name: 'heart' -%}
  </button>
</article>
