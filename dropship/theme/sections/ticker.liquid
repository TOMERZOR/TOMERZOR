{%- if section.blocks.size > 0 -%}
<div class="ticker" role="region" aria-label="יתרונות">
  <div class="ticker__track">
    {%- for n in (1..2) -%}
      <div class="ticker__group"{% if n == 2 %} aria-hidden="true"{% endif %}>
        {%- for rep in (1..2) -%}
          {%- for block in section.blocks -%}
            <span class="ticker__item" {% if n == 1 and rep == 1 %}{{ block.shopify_attributes }}{% endif %}>{% render 'icon', name: 'sparkle' %}{{ block.settings.text }}</span>
          {%- endfor -%}
        {%- endfor -%}
      </div>
    {%- endfor -%}
  </div>
</div>
{%- endif -%}

