{%- paginate blog.articles by 12 -%}
  <div class="page-wrap"><h1 class="policy__title">{{ blog.title | escape }}</h1></div>
  <div class="grid">
    {%- for article in blog.articles -%}
      <article class="card">
        <a class="card__link" href="{{ article.url }}">
          <div class="card__media">
            {%- if article.image -%}{{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900', sizes: '(min-width: 1200px) 25vw, 50vw', alt: article.image.alt | default: article.title, class: 'solo' }}{%- else -%}{{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}{%- endif -%}
          </div>
          <div class="card__info"><span class="card__name">{{ article.title | escape }}</span><span class="card__price">{{ article.published_at | time_tag: format: 'date' }}</span></div>
        </a>
      </article>
    {%- endfor -%}
  </div>
  {% render 'pagination', paginate: paginate %}
{%- endpaginate -%}

{% schema %}
{ "name": "Blog", "class": "section-main-blog", "settings": [] }
{% endschema %}
