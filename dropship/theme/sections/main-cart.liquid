<section class="section">
  <div class="container container--narrow">
    <h1 class="page-title">סל הקניות</h1>
    {%- if cart.item_count == 0 -%}
      <div class="empty-state">
        <p>הסל ריק.</p>
        <a class="btn" href="{{ routes.root_url }}">חזרה לחנות</a>
      </div>
    {%- else -%}
      <form action="{{ routes.cart_url }}" method="post" class="cart" novalidate>
        <ul class="cart__items">
          {%- for item in cart.items -%}
            <li class="cart-item">
              <a href="{{ item.url }}" class="cart-item__img">
                {%- if item.image -%}{{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: item.title }}{%- endif -%}
              </a>
              <div class="cart-item__info">
                <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title }}</a>
                {%- unless item.product.has_only_default_variant -%}<p class="cart-item__variant">{{ item.variant.title }}</p>{%- endunless -%}
                <p class="cart-item__price">{{ item.final_line_price | money }}</p>
                <div class="cart-item__qty">
                  <label class="visually-hidden" for="qty-{{ item.key }}">כמות</label>
                  <input id="qty-{{ item.key }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0" inputmode="numeric">
                  <a href="{{ item.url_to_remove }}" class="link">הסרה</a>
                </div>
              </div>
            </li>
          {%- endfor -%}
        </ul>
        <div class="cart__summary">
          {%- for discount in cart.cart_level_discount_applications -%}
            <p class="cart__discount">{{ discount.title }}: −{{ discount.total_allocated_amount | money }}</p>
          {%- endfor -%}
          <p class="cart__total"><span>סה"כ</span> <strong>{{ cart.total_price | money }}</strong></p>
          <p class="cart__note">משלוח חינם. המחירים כוללים את כל המסים, בלי עמלות נוספות.</p>
          <div class="cart__actions">
            <button type="submit" name="update" class="btn btn--ghost">עדכון הסל</button>
            <button type="submit" name="checkout" class="btn">לתשלום מאובטח</button>
          </div>
        </div>
      </form>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "סל קניות",
  "tag": "div"
}
{% endschema %}
