<section class="section{% if section.settings.bg == 'tint' %} section--tint{% endif %}">
  <div class="container">
    <div class="section-head reveal">
      <h2 class="display h2">{{ section.settings.title }}</h2>
    </div>
    <div class="bento">
      {%- for block in section.blocks -%}
        {%- liquid
          assign style = block.settings.style
          if block.settings.image != blank or block.settings.fallback != blank
            assign style = 'image'
          endif
        -%}
        <article class="tile tile--{{ style }} reveal" style="--i: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
          {%- if style == 'image' -%}
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 33vw, 100vw', widths: '400, 700, 1000', alt: '' }}
            {%- else -%}
              <img src="{{ block.settings.fallback | asset_url }}" alt="" width="800" height="1000" loading="lazy">
            {%- endif -%}
          {%- elsif block.settings.figure != blank -%}
            <span class="tile__figure" aria-hidden="true">{{ block.settings.figure }}</span>
          {%- endif -%}
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "יתרונות (בנטו)",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "כותרת",
      "default": "למה דווקא סאטן"
    },
    {
      "type": "select",
      "id": "bg",
      "label": "רקע",
      "options": [
        {
          "value": "",
          "label": "רגיל"
        },
        {
          "value": "tint",
          "label": "משני"
        }
      ],
      "default": ""
    }
  ],
  "max_blocks": 4,
  "blocks": [
    {
      "type": "tile",
      "name": "אריח",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "תמונה (אופציונלי)"
        },
        {
          "type": "text",
          "id": "fallback",
          "label": "תמונת ברירת מחדל מהערכה",
          "info": "שם קובץ מתיקיית assets, אם אין תמונה"
        },
        {
          "type": "select",
          "id": "style",
          "label": "סגנון כשאין תמונה",
          "options": [
            {
              "value": "accent",
              "label": "צבע הדגשה רך"
            },
            {
              "value": "ink",
              "label": "כהה"
            },
            {
              "value": "plain",
              "label": "רגיל"
            }
          ],
          "default": "accent"
        },
        {
          "type": "text",
          "id": "figure",
          "label": "מספר גדול (כשאין תמונה)",
          "info": "למשל 5. רק מספר אמיתי."
        },
        {
          "type": "text",
          "id": "title",
          "label": "כותרת",
          "default": "יתרון"
        },
        {
          "type": "text",
          "id": "text",
          "label": "טקסט (עד 15 מילים)",
          "default": "תיאור קצר"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "יתרונות (בנטו)"
    }
  ]
}
{% endschema %}
