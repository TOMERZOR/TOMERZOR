{%- comment -%}
  Slide-in bag. Re-rendered through the Section Rendering API after every cart change,
  so this markup is the single source of truth for the drawer.
{%- endcomment -%}
{%- liquid
  assign threshold = settings.free_shipping_from | times: 100
  assign remaining = threshold | minus: cart.total_price
  if threshold > 0
    assign progress = cart.total_price | times: 100 | divided_by: threshold
    if progress > 100
      assign progress = 100
    endif
  endif
-%}
<div class="scrim" id="scrim" data-cart-scrim></div>
<aside class="drawer" id="bag" aria-label="{{ 'cart.title' | t }}" aria-hidden="true" data-cart-drawer data-count="{{ cart.item_count }}">
  <div class="drawer__head">
    <h2 class="drawer__title">{{ 'cart.title' | t }}{% if cart.item_count > 0 %}<sup>{{ cart.item_count }}</sup>{% endif %}</h2>
    <button class="icon-btn" type="button" id="bag-close" aria-label="{{ 'cart.close' | t }}">{% render 'icon', name: 'close' %}</button>
  </div>

  {%- if threshold > 0 and cart.item_count > 0 -%}
    <div class="ship">
      {%- if remaining > 0 -%}
        {%- assign remaining_money = remaining | money -%}
        {{ 'cart.free_shipping_remaining_html' | t: amount: remaining_money }}
      {%- else -%}
        {{ 'cart.free_shipping_unlocked_html' | t }}
      {%- endif -%}
      <div class="ship__track"><div class="ship__fill" style="width: {{ progress }}%"></div></div>
    </div>
  {%- endif -%}

  <div class="drawer__items">
    {%- if cart.item_count == 0 -%}
      <div class="drawer__empty">
        <span>{{ 'cart.empty' | t }}</span>
        <a class="pill pill--ink" href="{{ settings.empty_cart_link | default: routes.all_products_collection_url }}">{{ 'cart.continue_shopping' | t }}</a>
      </div>
    {%- else -%}
      {%- for item in cart.items -%}
        <div class="line-item">
          <a href="{{ item.url }}" tabindex="-1" aria-hidden="true">
            {%- if item.image -%}
              {{ item.image | image_url: width: 200 | image_tag: loading: 'lazy', alt: '' }}
            {%- endif -%}
          </a>
          <div>
            <div class="line-item__top">
              <a class="line-item__name" href="{{ item.url }}">{{ item.product.title | escape }}</a>
              <span>{{ item.final_line_price | money }}</span>
            </div>
            <div class="line-item__meta">
              {%- unless item.product.has_only_default_variant -%}
                {%- for option in item.options_with_values -%}{{ option.value | escape }}{% unless forloop.last %} · {% endunless %}{%- endfor -%}
              {%- endunless -%}
              {%- for discount in item.line_level_discount_allocations -%}<br>{{ discount.discount_application.title | escape }} (−{{ discount.amount | money }}){%- endfor -%}
            </div>
            <div class="line-item__bottom">
              <div class="qty">
                <button type="button" data-line="{{ forloop.index }}" data-qty="{{ item.quantity | minus: 1 }}" aria-label="{{ 'cart.decrease' | t: title: item.product.title | escape }}">−</button>
                <span>{{ item.quantity }}</span>
                <button type="button" data-line="{{ forloop.index }}" data-qty="{{ item.quantity | plus: 1 }}" aria-label="{{ 'cart.increase' | t: title: item.product.title | escape }}">+</button>
              </div>
              <button type="button" class="link-btn" data-line="{{ forloop.index }}" data-qty="0">{{ 'cart.remove' | t }}</button>
            </div>
          </div>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>

  {%- if cart.item_count > 0 -%}
    <form class="drawer__foot" action="{{ routes.cart_url }}" method="post">
      {%- for discount in cart.cart_level_discount_applications -%}
        <div class="drawer__discount"><span>{{ discount.title | escape }}</span><span>−{{ discount.total_allocated_amount | money }}</span></div>
      {%- endfor -%}
      <div class="drawer__total"><span>{{ 'cart.subtotal' | t }}</span><span>{{ cart.total_price | money }}</span></div>
      <button class="pill pill--ink pill--block" type="submit" name="checkout">{{ 'cart.checkout' | t }}</button>
      {% render 'purchase-terms' %}
    </form>
  {%- endif -%}
</aside>

{% schema %}
{
  "name": "Bag drawer",
  "settings": []
}
{% endschema %}
